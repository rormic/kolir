-- Приклад локальних (машинно-специфічних) налаштувань Hyprland.
--
-- Скопіюйте цей файл у ~/.config/hypr/user.lua і змініть під свою машину
-- (`kolir setup` створює його автоматично, якщо файла ще немає).
-- Він НЕ зберігається в репозиторії: спільна частина лежить у
-- <root>/config/hypr/hyprland.lua, на неї посилається симлінк
-- ~/.config/hypr/hyprland.lua. user.lua підключається в кінці спільної
-- частини, тому його налаштування перекривають спільні.

------------------
---- MONITORS ----
------------------

hl.monitor({
	output = "",
	mode = "preferred",
	position = "auto",
	scale = "1",
})

-------------------
---- AUTOSTART ----
-------------------

hl.on("hyprland.start", function()
	hl.exec_cmd("sh ~/.config/hypr/scripts/launch-shell.sh")
	hl.exec_cmd("awww-daemon & kdeconnect-indicator")
end)

-------------------------------
---- ENVIRONMENT VARIABLES ----
-------------------------------

hl.env("XCURSOR_THEME", "Mocu-White-Left")
hl.env("HYPRCURSOR_THEME", "Mocu-White-Left")

----------------------
---- LOOK AND FEEL ----
----------------------

hl.config({
	decoration = {
		-- Dimensions.frame.radius must stay equal to this value: a mismatch
		-- leaves a gap or makes the frame clip the window border at the
		-- corners.
		rounding = 28,
		rounding_power = 2.0,
	},
})

---------------------
---- KEYBINDINGS ----
---------------------

local mainMod = "SUPER"

-- volume step 2% (overrides the shared 5% bindings)
hl.unbind("XF86AudioRaiseVolume")
hl.unbind("XF86AudioLowerVolume")
hl.bind(
	"XF86AudioRaiseVolume",
	hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+"),
	{ locked = true, repeating = true }
)
hl.bind(
	"XF86AudioLowerVolume",
	hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"),
	{ locked = true, repeating = true }
)
